{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meshlab-chat",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "ACCOUNT_BUDGET", "class_name": "AccountBudget" }] },
  "exports": { "AccountBudget": { "type": "durable-object", "storage": "sqlite" } },
  "vars": {
    "ALLOWED_ORIGINS": "https://slack-zh.github.io",
    "DEEPSEEK_MODEL": "deepseek-flash",
    "FIREBASE_PROJECT_ID": "meshlab-680d9",
    "REQUIRE_EMAIL_VERIFICATION": "false"
  }
}
