{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meshlab-chat",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "vars": {
    "ALLOWED_ORIGINS": "https://slack-zh.github.io",
    "DEEPSEEK_MODEL": "deepseek-flash"
  }
}
